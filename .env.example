# Qinit-web backend configuration. Copy to `.env` (the backend runs under Bun, which auto-loads `.env` from its
# working directory — for local dev copy this to `backend/.env`; docker-compose reads this file at the repo root).
# Values marked REQUIRED-IN-PROD must be set when NODE_ENV=production or the server refuses to start / loses data.

# ---- core ----
NODE_ENV=development                       # production | development
PORT=8787
FRONTEND_URL=http://localhost:5180         # where the SPA is served (OAuth redirects land here)

# ---- auth / OAuth ----
# REQUIRED-IN-PROD: a strong (>=24 char) random secret signs JWTs + OAuth state. Generate: openssl rand -base64 48
SESSION_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:8787  # the public base the providers redirect back to (…/api/auth/:provider/callback)
GOOGLE_CLIENT_ID=                          # leave blank to disable Google login (returns 503)
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=                          # leave blank to disable GitHub login
GITHUB_CLIENT_SECRET=
# QINIT_DEV_AUTH=1                         # DEV ONLY: enable the /api/auth/dev token mint. Never set in prod.

# ---- data stores ----
# REQUIRED-IN-PROD: a failed Mongo connect aborts boot in production (no silent in-memory fallback).
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=qinit_web
# QINIT_NO_DB=1                            # force the in-memory data layer (tests / explicit opt-out). Not for prod.
# REDIS_URL=redis://127.0.0.1:6379         # optional: enables cross-instance collab fan-out. Unset = single instance.

# ---- security ----
CORS_ORIGINS=http://localhost:5180         # comma list of allowed browser origins ("*" disables the allowlist — avoid in prod)
# TRUST_PROXY=1                            # set when behind a load balancer / reverse proxy (uses X-Forwarded-For for IP)

# ---- rate limits (requests per minute, per IP) ----
RL_API=600                                 # global ceiling on /api
RL_COMPILE=12                              # the expensive build route
RL_AUTH=30
RL_SHARE=30

# ---- admin dashboard ----
# Set to enable /admin (the dashboard sends it as X-Admin-Token). Unset = admin disabled (503).
ADMIN_TOKEN=

# ---- metrics + overload thresholds ----
QINIT_METRICS_INTERVAL=15000               # sampler period (ms)
QINIT_METRICS_PERSIST_MS=60000             # Mongo persist cadence (ms); also the outage-gap basis
QINIT_METRICS_TTL_DAYS=7                   # per-sample retention
QINIT_INCIDENT_TTL_DAYS=90                 # incident-timeline retention
QINIT_MEM_WARN=85
QINIT_MEM_CRIT=95
QINIT_LOAD_WARN=100
QINIT_LOAD_CRIT=200

# ---- build sandbox ----
# The compiler runs untrusted source in a killable, resource-limited child process.
QINIT_BUILD_TIMEOUT_MS=30000               # hard wall-clock timeout (then SIGKILL the build group)
QINIT_BUILD_CPU_SEC=30                     # ulimit -t
QINIT_BUILD_MEM_MB=4096                    # ulimit -v (address space)
QINIT_BUILD_FILE_MB=64                     # ulimit -f (output size)
QINIT_BUILD_CONCURRENCY=                   # parallel builds (default ~cores-1, capped 8)
# QINIT_BUILD_INPROC=1                     # DEV: run the build in-process (no sandbox) — needs bash otherwise. Never in prod.
# QINIT_CORE=/path/to/core/headers         # the core-lite header snapshot the compiler builds against (else `qinit up`'s synced copy)

# ---- logging ----
LOG_LEVEL=info                             # debug | info | warn | error

# ---- misc ----
# GITHUB_REPO=hackerby888/qinit            # repo the /api/release/latest endpoint reads
