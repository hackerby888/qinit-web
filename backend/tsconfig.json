{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    // @qinit/build's own imports have to be mapped too, or tsc falls back to node resolution and lands in
    // packages/*/dist — the wrong entry (the browser surface) when it is stale, and nothing at all in CI,
    // where the sibling is installed but never built. Same targets as the monorepo's own tsconfig.
    "paths": {
      "@qinit/build": ["../../Qinit/packages/build/src/index.ts"],
      "@qinit/build/*": ["../../Qinit/packages/build/src/*"],
      "@qinit/compiler": ["../../Qinit/packages/compiler/src/index.ts"],
      "@qinit/compiler/*": ["../../Qinit/packages/compiler/src/*"],
      "@qinit/core": ["../../Qinit/packages/core/src/index.ts"],
      "@qinit/core/*": ["../../Qinit/packages/core/src/*"],
      "@qinit/proto": ["../../Qinit/packages/proto/src/index.ts"],
      "@qinit/proto/*": ["../../Qinit/packages/proto/src/*"]
    }
  },
  "include": ["src"]
}
